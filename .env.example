# Get a free key at https://build.nvidia.com (NVIDIA Developer Program)
# If unset, the agent runs against a deterministic stub responder so the
# demo flow still works. The receipt will record provider="stub".
NVIDIA_API_KEY=

# OpenAI-compatible NIM endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model. Any NIM-hosted chat model works.
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Identity stamped on the receipt. Override in the Streamlit sidebar.
RECEIPT_USER=me@andyrosic.com

# Confidence thresholds. Below CAVEAT, the agent answers with a caveat.
# Below ABSTAIN, the agent declines and routes to human review.
CONFIDENCE_CAVEAT_THRESHOLD=0.65
CONFIDENCE_ABSTAIN_THRESHOLD=0.40

# Optional. Pin the agent's "today" so the recency component of confidence
# stays stable as the demo data ages. ISO date. Leave unset to use date.today().
REFERENCE_DATE=2026-04-23
